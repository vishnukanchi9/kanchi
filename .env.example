# Optional. When unset the app uses embedded PGLite (Postgres in WASM).
DATABASE_URL=

# Optional sign-in. All four are needed together; leave them unset and the labs
# run as a shared public workspace, which is the default experience.
#
# OAUTH_ISSUER is the base URL of any OpenID Connect provider — endpoints are
# read from its /.well-known/openid-configuration document.
OAUTH_ISSUER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
BETTER_AUTH_SECRET=

# Optional. Public origin of the deployment, e.g. https://example.com
BETTER_AUTH_URL=

# Optional. Name shown on the sign-in button, e.g. "Google"
VITE_OAUTH_LABEL=
